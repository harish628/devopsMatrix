pipeline {
    agent any

    parameters {
        choice(name: 'ACTION', choices: ['Initialize', 'Delete'], description: 'Initialize or delete the EKS cluster and its Kubernetes resources.')
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION      = 'ap-south-1'
        ECR_REPOSITORY  = 'static-site'
        EKS_CLUSTER     = 'demo2'
        K8S_NAMESPACE   = 'static-site'
        IMAGE_TAG       = "${BUILD_NUMBER}"
    }

    stages {
        stage('Delete EKS cluster and associated resources') {
            when {
                beforeAgent true
                expression { params.ACTION == 'Delete' }
            }
            steps {
                script {
                    try {
                        sh '''#!/bin/sh
                            set -eu
                            if eksctl get cluster --name "$EKS_CLUSTER" --region "$AWS_REGION" >/dev/null 2>&1; then
                                aws eks update-kubeconfig --region "$AWS_REGION" --name "$EKS_CLUSTER"
                                if kubectl get namespace "$K8S_NAMESPACE" >/dev/null 2>&1; then
                                    kubectl delete namespace "$K8S_NAMESPACE" --wait=true --timeout=10m
                                fi
                                eksctl delete cluster --name "$EKS_CLUSTER" --region "$AWS_REGION" --wait
                            else
                                echo "EKS cluster $EKS_CLUSTER does not exist; nothing to delete."
                            fi
                        '''
                        echo "\u001B[32mSUCCESS: EKS cluster and associated Kubernetes resources were deleted.\u001B[0m"
                    } catch (err) {
                        echo "\u001B[31mFAILURE: EKS teardown failed: ${err}\u001B[0m"
                        throw err
                    }
                }
            }
        }

        stage('Resolve AWS account ID') {
            when { expression { params.ACTION == 'Initialize' } }
            steps {
                script {
                    try {
                        env.AWS_ACCOUNT_ID = sh(
                            script: 'aws sts get-caller-identity --query Account --output text --region "$AWS_REGION"',
                            returnStdout: true
                        ).trim()
                        if (!(env.AWS_ACCOUNT_ID ==~ /[0-9]{12}/)) {
                            error('AWS identity returned an invalid account ID.')
                        }
                        echo "\u001B[32mSUCCESS: Resolved AWS account ID ${env.AWS_ACCOUNT_ID}.\u001B[0m"
                    } catch (err) {
                        echo "\u001B[31mFAILURE: AWS account ID resolution failed: ${err}\u001B[0m"
                        throw err
                    }
                }
            }
        }
        stage('Checkout and validate source') {
            when { expression { params.ACTION == 'Initialize' } }
            steps {
                script {
                    try {
                        git branch: 'main', url: 'https://github.com/harish628/devopsMatrix.git'
                        if (!fileExists('Dockerfile')) {
                            error('Dockerfile is missing from the repository root.')
                        }
                        echo "\u001B[32mSUCCESS: Source checkout and Dockerfile validation passed.\u001B[0m"
                    } catch (err) {
                        echo "\u001B[31mFAILURE: Checkout/source validation failed: ${err}\u001B[0m"
                        throw err
                    }
                }
            }
        }

        stage('Build Docker image') {
            when { expression { params.ACTION == 'Initialize' } }
            steps {
                script {
                    try {
                        withEnv(["ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"]) {
                            sh 'docker build --pull -t "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG" .'
                            sh 'docker image inspect "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG" >/dev/null'
                        }
                        ansiColor('xterm') {
                            echo "\u001B[32mSUCCESS: Docker image built and verified.\u001B[0m"
                        }
                    } catch (err) {
                        ansiColor('xterm') {
                            echo "\u001B[31mFAILURE: Docker build/verification failed: ${err}\u001B[0m"
                        }
                        throw err
                    }
                }
            }
        }

        stage('Push image to ECR') {
            when { expression { params.ACTION == 'Initialize' } }
            steps {
                script {
                    try {
                        withEnv(["ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"]) {
                            sh '''#!/bin/sh
                                set -eu
                                aws sts get-caller-identity --region "$AWS_REGION" >/dev/null
                                if aws ecr describe-repositories --region "$AWS_REGION" --repository-names "$ECR_REPOSITORY" >/dev/null 2>&1; then
                                    echo "ECR repository $ECR_REPOSITORY already exists; skipping creation."
                                else
                                    echo "ECR repository $ECR_REPOSITORY does not exist; creating it."
                                    aws ecr create-repository --region "$AWS_REGION" --repository-name "$ECR_REPOSITORY" >/dev/null
                                fi
                                aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"
                                docker push "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"
                                aws ecr describe-images --region "$AWS_REGION" --repository-name "$ECR_REPOSITORY" --image-ids imageTag="$IMAGE_TAG" >/dev/null
                            '''
                        }
                        echo "\u001B[32mSUCCESS: Image push and ECR image lookup passed.\u001B[0m"
                    } catch (err) {
                        echo "\u001B[31mFAILURE: ECR push/validation failed: ${err}\u001B[0m"
                        throw err
                    }
                }
            }
        }

        stage('Create EKS cluster') {
            when { expression { params.ACTION == 'Initialize' } }
            steps {
                script {
                    try {
                        sh '''#!/bin/sh
                            set -eu
                            if eksctl get cluster --name "$EKS_CLUSTER" --region "$AWS_REGION" >/dev/null 2>&1; then
                                echo "EKS cluster $EKS_CLUSTER already exists."
                            else
                                eksctl create cluster --name "$EKS_CLUSTER" --region "$AWS_REGION" --without-nodegroup
                            fi
                            aws eks wait cluster-active --name "$EKS_CLUSTER" --region "$AWS_REGION"
                        '''
                        echo "\u001B[32mSUCCESS: EKS cluster is active.\u001B[0m"
                    } catch (err) {
                        echo "\u001B[31mFAILURE: EKS cluster creation/health check failed: ${err}\u001B[0m"
                        throw err
                    }
                }
            }
        }

        stage('Create EKS node group') {
            when { expression { params.ACTION == 'Initialize' } }
            steps {
                script {
                    try {
                        sh '''#!/bin/sh
                            set -eu
                            if eksctl get nodegroup --cluster "$EKS_CLUSTER" --region "$AWS_REGION" >/dev/null 2>&1; then
                                echo "A node group already exists for $EKS_CLUSTER."
                            else
                                    eksctl create nodegroup --cluster "$EKS_CLUSTER" --region "$AWS_REGION" \\
                                        --name "${EKS_CLUSTER}-nodegroup" \\
                                        --node-type c7i-flex.large --node-volume-size 28 \\
                                        --ssh-access --ssh-public-key keypair \\
                                        --managed --asg-access --external-dns-access \\
                                        --full-ecr-access --appmesh-access --alb-ingress-access \\
                                        --nodes 2 --nodes-min 1 --nodes-max 3
                            fi
                            aws eks update-kubeconfig --region "$AWS_REGION" --name "$EKS_CLUSTER"
                            if ! command -v kubectl >/dev/null 2>&1; then
                                echo "kubectl is missing from the Jenkins agent PATH. Install kubectl on the agent and rerun this pipeline." >&2
                                exit 127
                            fi
                            kubectl wait --for=condition=Ready nodes --all --timeout=30m
                            kubectl get nodes 
                        '''
                        echo "\u001B[32mSUCCESS: EKS node group is healthy.\u001B[0m"
                    } catch (err) {
                        echo "\u001B[31mFAILURE: EKS node group creation/health check failed: ${err}\u001B[0m"
                        throw err
                    }
                }
            }
        }

        stage('Apply Kubernetes manifests') {
            when { expression { params.ACTION == 'Initialize' } }
            steps {
                script {
                    try {
                        sh '''#!/bin/sh
                            set -eu
                            kubectl apply -f EKS/kubernetes/namespace.yaml
                            kubectl apply -n "$K8S_NAMESPACE" -f EKS/kubernetes/deployment.yaml
                            kubectl apply -n "$K8S_NAMESPACE" -f EKS/kubernetes/service.yaml
                            kubectl rollout status deployment --all -n "$K8S_NAMESPACE" --timeout=10m
                            kubectl wait --for=condition=Ready pods --all -n "$K8S_NAMESPACE" --timeout=10m
                            kubectl wait --for=jsonpath='{.status.loadBalancer.ingress}' service --all -n "$K8S_NAMESPACE" --timeout=10m
                            echo 'LoadBalancer service URL:'
                            kubectl get services -n "$K8S_NAMESPACE" -o go-template='{{range .items}}{{if eq .spec.type "LoadBalancer"}}{{with index .status.loadBalancer.ingress 0}}{{if .hostname}}http://{{.hostname}}{{else}}http://{{.ip}}{{end}}{{"\n"}}{{end}}{{end}}{{end}}'
                        '''
                        echo "\u001B[32mSUCCESS: Kubernetes resources are healthy and service URLs were printed.\u001B[0m"
                    } catch (err) {
                        echo "\u001B[31mFAILURE: Kubernetes apply/health check failed: ${err}\u001B[0m"
                        throw err
                    }
                }
            }
        }

    }

    post {
        success {
            echo "\u001B[32mPIPELINE SUCCESS: Every stage completed and passed validation.\u001B[0m"
        }
        failure {
            echo "\u001B[31mPIPELINE FAILURE: Review the failed stage output above.\u001B[0m"
        }
        always {
            script {
                def registry = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                sh "docker image rm '${registry}/${env.ECR_REPOSITORY}:${env.IMAGE_TAG}' >/dev/null 2>&1 || true"
            }
        }
    }
}